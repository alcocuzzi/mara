#!/usr/bin/env python3
"""
Interactive Terraform version manager.

Lists the latest stable Terraform release per minor version (From 1.14.9+),
lets the user pick one, and swaps it into /usr/local/bin/terraform.

Downloaded binaries are cached under /tmp/terraform_v<version>, and every
swap simply exchanges the active binary with the cached one for the
target version -- so switching back and forth between versions never
re-downloads anything.
"""

import os
import re
import shutil
import subprocess
import urllib.request
import zipfile
from platform import machine
import typer
from rich.console import Console
from rich.progress import BarColumn, DownloadColumn, Progress, TextColumn, TransferSpeedColumn
from rich.table import Table

app = typer.Typer(help="Interactively switch the installed Terraform version.")
console = Console()

RELEASES_URL = "https://releases.hashicorp.com/terraform/"
TF_BIN = "/usr/local/bin/terraform"
MIN_VERSION = (1, 14, 9)
ARCH_MAP = {"x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64"}


def get_current_version():
    """Return the currently installed Terraform version, or None if not found."""
    try:
        out = subprocess.run([TF_BIN, "version"], capture_output=True, text=True, check=True)
        match = re.search(r"Terraform v(\d+\.\d+\.\d+)", out.stdout)
        return match.group(1) if match else None
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None


def fetch_latest_per_minor():
    """Fetch the releases index and return the latest stable patch per minor line (>= MIN_VERSION)."""
    try:
        with urllib.request.urlopen(RELEASES_URL, timeout=15) as resp:
            html = resp.read().decode()
    except Exception as e:
        typer.secho(f"Failed to fetch releases list: {e}", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    # Only match clean semantic versions (e.g. 1.15.9) -- this naturally
    # excludes -alpha, -beta and -rc tagged directories.
    found = re.findall(r'href="/terraform/(\d+\.\d+\.\d+)/"', html)

    latest_per_minor = {}
    for v in found:
        parts = tuple(int(p) for p in v.split("."))
        if parts < MIN_VERSION:
            continue
        minor_key = parts[:2]
        if minor_key not in latest_per_minor or parts > latest_per_minor[minor_key]:
            latest_per_minor[minor_key] = parts

    return [".".join(str(p) for p in v) for v in sorted(latest_per_minor.values())]


def select_version(versions, current_version):
    """Display versions in a table and prompt the user to pick one."""
    table = Table(show_header=True)
    table.add_column("#", style="dim")
    table.add_column("Version")
    table.add_column("Status")

    for i, v in enumerate(versions, 1):
        status = "[green]active[/green]" if v == current_version else ""
        table.add_row(str(i), v, status)

    console.print(table)

    try:
        choice = int(input("Select version number to install: ")) - 1
        if 0 <= choice < len(versions):
            return versions[choice]
    except (ValueError, KeyboardInterrupt):
        pass

    typer.secho("Invalid selection", fg=typer.colors.RED, err=True)
    raise typer.Exit(code=1)


def install_version(version, current_version):
    """Download (if not already cached) and swap in the requested Terraform version."""
    if version == current_version:
        typer.secho(f"Terraform {version} is already active", fg=typer.colors.YELLOW)
        raise typer.Exit(code=0)

    cached_path = f"/tmp/terraform_v{version}"

    if not os.path.exists(cached_path):
        arch = ARCH_MAP.get(machine())
        if not arch:
            typer.secho(f"Unsupported architecture: {machine()}", fg=typer.colors.RED, err=True)
            raise typer.Exit(code=1)

        url = f"{RELEASES_URL}{version}/terraform_{version}_linux_{arch}.zip"
        zip_path = f"/tmp/terraform_{version}.zip"

        progress = Progress(
            TextColumn(f"[bold blue]Downloading {version}"),
            BarColumn(),
            DownloadColumn(),
            TransferSpeedColumn(),
        )

        with progress:
            task_id = progress.add_task("download", total=None)

            def report(block_num, block_size, total_size):
                if total_size > 0:
                    progress.update(task_id, total=total_size, completed=block_num * block_size)

            try:
                urllib.request.urlretrieve(url, zip_path, reporthook=report)
            except Exception as e:
                typer.secho(f"Download failed: {e}", fg=typer.colors.RED, err=True)
                raise typer.Exit(code=1)

        with zipfile.ZipFile(zip_path) as zf:
            zf.extract("terraform", "/tmp")
        os.remove(zip_path)
        shutil.move("/tmp/terraform", cached_path)
        os.chmod(cached_path, 0o755)
    else:
        typer.echo(f"Using cached binary for {version} from /tmp")

    if current_version and os.path.exists(TF_BIN):
        shutil.move(TF_BIN, f"/tmp/terraform_v{current_version}")

    shutil.move(cached_path, TF_BIN)
    os.chmod(TF_BIN, 0o755)

    typer.secho(f"Terraform {version} is now active at {TF_BIN}", fg=typer.colors.GREEN)


@app.command()
def main():
    """List available Terraform versions and interactively switch to one."""
    current_version = get_current_version()
    
    versions = fetch_latest_per_minor()
    if not versions:
        typer.secho("No versions found", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    selected = select_version(versions, current_version)
    install_version(selected, current_version)


if __name__ == "__main__":
    app()