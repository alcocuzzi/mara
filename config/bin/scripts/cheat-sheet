def display_commands(data):
    for category, commands in data.items():
        console.print(f"\n [bold green]{category}[/bold green]")
        table = [[cmd["command"], cmd["description"]] for cmd in commands]
        console.print(tabulate(table, headers=["Command", "Description"], tablefmt="rounded_grid"))


@app.command()
def main(
    git: bool = typer.Option(False, "--git", "-g", help="Show useful commands for git/git-cli utilities"),
    ansible: bool = typer.Option(False, "--ansible", "-a", help="Show useful commands for ansible"),
    vi: bool = typer.Option(False, "--vi", "-v", help="Show useful vi commands"),
    linux: bool = typer.Option(False, "--linux", "-l", help="Show useful Linux system commands"),
    debug: bool = typer.Option(False, "--debug", help="Show more verbose logging"),
):
    """
    Display useful cheat-sheet commands from useful tools.
    """
    if debug:
        typer.echo("Debug mode enabled", err=True)
        typer.echo(f"git: {git}, ansible: {ansible}, vi: {vi}, linux: {linux}, debug: {debug}", err=True)

    if git:
        if debug:
            typer.echo("Showing Git and GitHub CLI useful commands...", err=True)
        display_commands(gh_commands)
    if ansible:
        if debug:
            typer.echo("Showing Ansible useful commands...", err=True)
        display_commands(ansible_commands)
    if vi:
        if debug:
            typer.echo("Showing Vi useful commands...", err=True)
        display_commands(vi_commands)
    if linux:
        if debug:
            typer.echo("Showing Linux system commands...", err=True)
        display_commands(linux_commands)
    if not any([git, ansible, vi, linux]):
        typer.secho("No option selected. Use --help to see available options.", fg=typer.colors.YELLOW)


if __name__ == "__main__":
    app()