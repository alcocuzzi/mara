#!/usr/bin/env python3
"""
Mara utility to logout AWS active session.
"""

import typer
from subprocess import run, CalledProcessError
from os import environ, path
import logging

app = typer.Typer(help="Mara utility to logout AWS active session.")

# Suppress boto3/botocore noise if they are present in the environment
logging.getLogger("boto3").setLevel(logging.WARNING)
logging.getLogger("botocore").setLevel(logging.WARNING)


def logout(debug: bool = False) -> None:
    """Logout from AWS by clearing credentials and related environment variables."""
    home_dir = environ.get("HOME")

    if not home_dir:
        typer.secho("HOME environment variable not set", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    credentials_path = path.join(home_dir, ".aws", "credentials")
    config_path = path.join(home_dir, ".aws", "config")

    try:
        if debug:
            typer.echo(f"Checking AWS credentials at {credentials_path}", err=True)

        with open(credentials_path) as creds_file:
            content = creds_file.read()

        if "aws_access_key_id" not in content:
            typer.secho(
                "This command requires you to login on AWS first",
                fg=typer.colors.RED,
                err=True,
            )
            raise typer.Exit(code=0)

        # Clear credentials and config
        open(credentials_path, "w").close()
        open(config_path, "w").close()

        if debug:
            typer.echo("Cleared AWS credentials and config files", err=True)

        variables_to_remove = [
            "mara_acc_number",
            "mara_acc_alias",
            "mara_identity",
            "mara_region",
        ]

        for variable in variables_to_remove:
            try:
                if debug:
                    typer.echo(f"Removing Fish env var: {variable}", err=True)

                run(
                    f"set -e {variable}",
                    shell=True,
                    executable="/usr/bin/fish",
                    check=True,
                )
            except CalledProcessError:
                if debug:
                    typer.echo(
                        f"Env var {variable} not set or could not be removed",
                        err=True,
                    )

        typer.secho("AWS session successfully logged out", fg=typer.colors.GREEN)

    except FileNotFoundError:
        typer.secho(
            "This command requires you to login on AWS first",
            fg=typer.colors.RED,
            err=True,
        )
        raise typer.Exit(code=0)


@app.command()
def main(
    debug: bool = typer.Option(
        False,
        "--debug",
        help="Show more verbose logging",
    ),
):
    """
    Logout AWS active session.

    This utility clears AWS credentials files and removes
    Mara-related AWS environment variables from the Fish shell.
    """
    if debug:
        typer.echo("Debug mode enabled", err=True)

    logout(debug)


if __name__ == "__main__":
    app()
