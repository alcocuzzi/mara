#!/usr/bin/env python3
"""
Mara utility to switch AWS regions.
"""
from logging import getLogger, WARNING
import typer
import configparser
from subprocess import run
from os import environ, path

app = typer.Typer(help="Mara utility to switch AWS regions.")

# Suppress boto3/botocore logging to avoid message `Found credentials in shared credentials file: ~/.aws/credentials`
getLogger('boto3').setLevel(WARNING)
getLogger('botocore').setLevel(WARNING)


def set_region(region_name: str, debug: bool = False):
    """Set the AWS region in config file and environment."""
    home_dir = environ['HOME']
    config_path = f"{home_dir}/.aws/config"
    
    if not path.exists(config_path):
        typer.secho("This command requires you to login on AWS first", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)
    
    if debug:
        typer.echo(f"Setting AWS region to: {region_name}", err=True)
        typer.echo(f"Config file path: {config_path}", err=True)
    
    config = configparser.ConfigParser()
    
    try:
        with open(config_path, "w") as config_file:
            config.add_section("default")
            config.set("default", "region", region_name)
            config.set("default", "output", "json")
            config.write(config_file)
        
        if debug:
            typer.echo(f"AWS config file updated successfully", err=True)
        
        # Set fish shell environment variable
        result = run(
            f"set -Ux mara_region {region_name}", 
            shell=True, 
            executable="/usr/bin/fish", 
            check=True,
            capture_output=True,
            text=True
        )
        
        if debug:
            typer.echo(f"Fish environment variable set successfully", err=True)
        
        typer.secho(f"AWS region switched to: {region_name}", fg=typer.colors.GREEN)
        
    except Exception as e:
        typer.secho(f"Error setting region: {str(e)}", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)


@app.command()
def main(
    region_name: str = typer.Argument(..., help="AWS region name to switch to (e.g., us-east-1, eu-west-1)"),
    debug: bool = typer.Option(False, "--debug", help="Show more verbose logging"),
):
    """
    Switch AWS region configuration.
    
    Examples:
        aws-region us-east-1
        aws-region eu-west-1 --debug
    """
    if debug:
        typer.echo("Debug mode enabled", err=True)
        typer.echo(f"Region: {region_name}", err=True)
    
    set_region(region_name, debug)


if __name__ == "__main__":
    app()