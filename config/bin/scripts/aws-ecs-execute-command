#!/usr/bin/env python3
"""
Utility to execute commands on ECS tasks for a specific service.
"""

import typer
import curses
from boto3 import client
from botocore.exceptions import ClientError, NoRegionError
from subprocess import run
from rich.console import Console
from rich.table import Table
import logging

app = typer.Typer(help="Execute commands on ECS tasks for a specific service.")
console = Console()

# Silence boto noise
logging.getLogger("boto3").setLevel(logging.WARNING)
logging.getLogger("botocore").setLevel(logging.WARNING)


def get_tasks(cluster: str, service: str):
    """Get all ECS tasks for a service."""
    try:
        ecs = client("ecs")

        response = ecs.list_tasks(
            cluster=cluster,
            serviceName=service,
        )

        task_arns = response.get("taskArns", [])
        if not task_arns:
            typer.secho(
                f"No tasks found for service '{service}' in cluster '{cluster}'",
                fg=typer.colors.RED,
                err=True,
            )
            return []

        details = ecs.describe_tasks(cluster=cluster, tasks=task_arns)
        return details.get("tasks", [])

    except NoRegionError:
        typer.secho(
            "This command requires you to login on AWS first",
            fg=typer.colors.RED,
            err=True,
        )
        raise typer.Exit(code=1)
    except ClientError as e:
        typer.secho(str(e), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)


def format_task_info(tasks):
    """Format task info for display."""
    info = []

    for task in tasks:
        definition = task["taskDefinitionArn"].split("/")[-1]
        name, _, version = definition.partition(":")

        info.append(
            {
                "arn": task["taskArn"],
                "definition": name,
                "version": version or "unknown",
                "health": task.get("healthStatus", "UNKNOWN"),
                "containers": [c["name"] for c in task.get("containers", [])],
            }
        )

    return info


def display_tasks_interactive(tasks_info, cluster: str):
    """Interactive curses UI for task selection."""
    if not tasks_info:
        return None

    def curses_main(stdscr):
        curses.curs_set(0)
        curses.start_color()

        curses.init_pair(1, curses.COLOR_WHITE, curses.COLOR_BLUE)
        curses.init_pair(2, curses.COLOR_GREEN, curses.COLOR_BLACK)
        curses.init_pair(3, curses.COLOR_YELLOW, curses.COLOR_BLACK)
        curses.init_pair(4, curses.COLOR_RED, curses.COLOR_BLACK)

        current = 0

        while True:
            stdscr.clear()
            max_y, max_x = stdscr.getmaxyx()

            header = f"Tasks for cluster: {cluster}"
            stdscr.addstr(0, (max_x - len(header)) // 2, header, curses.A_BOLD)

            headers = "# | Task Definition | Version | Health"
            stdscr.addstr(2, 2, headers, curses.A_BOLD)
            stdscr.addstr(3, 2, "-" * (len(headers) + 6))

            for i, task in enumerate(tasks_info):
                if task["health"] == "HEALTHY":
                    health_color = curses.color_pair(2)
                elif task["health"] == "UNHEALTHY":
                    health_color = curses.color_pair(4)
                else:
                    health_color = curses.color_pair(3)

                attr = curses.color_pair(1) if i == current else curses.A_NORMAL
                line = f"{i+1:2} | {task['definition']:<20} | {task['version']:<7} | "

                y = 4 + i
                if y < max_y - 3:
                    stdscr.addstr(y, 2, line, attr)
                    stdscr.addstr(
                        y,
                        2 + len(line),
                        task["health"],
                        attr if i == current else health_color,
                    )

            instructions = "UP/DOWN: select  ENTER: execute  q: quit"
            stdscr.addstr(max_y - 2, (max_x - len(instructions)) // 2, instructions)

            key = stdscr.getch()

            if key == curses.KEY_UP and current > 0:
                current -= 1
            elif key == curses.KEY_DOWN and current < len(tasks_info) - 1:
                current += 1
            elif key == 10:
                return current
            elif key == ord("q"):
                return None

    try:
        idx = curses.wrapper(curses_main)
        return tasks_info[idx] if idx is not None else None
    except Exception as e:
        typer.secho(f"Curses UI error: {e}", fg=typer.colors.RED, err=True)
        return None


def choose_container(containers):
    """Choose container if multiple exist."""
    if len(containers) == 1:
        return containers[0]

    table = Table(show_header=True)
    table.add_column("#", style="dim")
    table.add_column("Container Name")

    for i, c in enumerate(containers, 1):
        table.add_row(str(i), c)

    console.print(table)

    try:
        idx = int(input("Select container number: ")) - 1
        if 0 <= idx < len(containers):
            return containers[idx]
    except (ValueError, KeyboardInterrupt):
        pass

    typer.echo("Invalid selection, using first container", err=True)
    return containers[0]


def execute_command(cluster: str, task_arn: str, container: str, command: str):
    """Execute ECS execute-command."""
    cmd = (
        f'aws ecs execute-command '
        f'--cluster "{cluster}" '
        f'--task {task_arn} '
        f'--container "{container}" '
        f'--interactive '
        f'--command "{command}"'
    )

    typer.echo(f"Executing: {cmd}", err=True)
    run(cmd, shell=True)


@app.command()
def main(
    cluster: str = typer.Option(..., "--cluster", "-c", help="ECS cluster name"),
    service: str = typer.Option(..., "--service", "-s", help="ECS service name"),
    command: str = typer.Option(
        "/bin/sh",
        "--command",
        "-C",
        help="Command to execute inside the container",
    ),
):
    """
    Execute a command on a running ECS task.

    Displays an interactive list of tasks and lets you select
    which task and container to execute against.
    """
    typer.echo(f"Retrieving tasks for service {service} in cluster {cluster}", err=True)

    tasks = get_tasks(cluster, service)
    tasks_info = format_task_info(tasks)

    selected = display_tasks_interactive(tasks_info, cluster)
    if not selected:
        typer.echo("Operation cancelled", err=True)
        raise typer.Exit(code=0)

    container = choose_container(selected["containers"])
    execute_command(cluster, selected["arn"], container, command)


if __name__ == "__main__":
    app()
