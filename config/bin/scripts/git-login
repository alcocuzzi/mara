#!/usr/bin/env python3
"""
Mara utility to load Git access token from SSM Parameter store. 
Please make sure to save your access token on SSM Parameter store before using this utility.
"""

from boto3 import client, session
from botocore.exceptions import ClientError, NoRegionError
from logging import getLogger, WARNING
from rich.console import Console
from sys import exit
import typer
from os import environ
from subprocess import run, CalledProcessError, PIPE
import json

console = Console()
app = typer.Typer(help="Mara utility to load Git access token and configure Git credentials.")

# Suppress boto3/botocore logging
getLogger('boto3').setLevel(WARNING)
getLogger('botocore').setLevel(WARNING)


def get_platform_selection(debug: bool = False) -> tuple[str, str]:
    """Get Git platform selection from user."""
    git_platforms = ["Github", "Gitlab"]
    
    console.print("\n[bold cyan]Select Git platform:[/bold cyan]")
    for i, platform in enumerate(git_platforms, 1):
        console.print(f"{i} ❯ {platform}")

    try:
        selected_index = input()
    except KeyboardInterrupt:
        typer.echo("\nOperation cancelled", err=True)
        raise typer.Exit(0)
    
    try:
        selected_index = int(selected_index)
        if 1 <= selected_index <= len(git_platforms):
            selected_platform = git_platforms[selected_index - 1]
            machine = "github.com" if selected_platform == "Github" else "gitlab.com"
            
            if debug:
                typer.echo(f"Selected platform: {selected_platform}", err=True)
            
            return selected_platform, machine
        else:
            typer.secho("Invalid selection.", fg=typer.colors.YELLOW, err=True)
            raise typer.Exit(0)
    except ValueError:
        typer.secho("Invalid input. Please enter a number.", fg=typer.colors.YELLOW, err=True)
        raise typer.Exit(0)


def get_github_user_info(token: str, debug: bool = False) -> tuple[str, str]:
    """Fetch GitHub username and email using the GitHub CLI or API."""
    try:
        # Try using gh CLI first
        if debug:
            typer.echo("Attempting to fetch user info using GitHub CLI...", err=True)
        
        # Set the token as environment variable for gh CLI
        env = environ.copy()
        env['GH_TOKEN'] = token
        
        result = run(
            ['gh', 'api', 'user'],
            capture_output=True,
            text=True,
            env=env,
            check=True
        )
        
        user_data = json.loads(result.stdout)
        username = user_data.get('login', '')
        
        # Get primary email
        email_result = run(
            ['gh', 'api', 'user/emails'],
            capture_output=True,
            text=True,
            env=env,
            check=True
        )
        
        emails = json.loads(email_result.stdout)
        # Find primary email
        email = next((e['email'] for e in emails if e.get('primary')), '')
        
        if not email and emails:
            email = emails[0]['email']  # Fallback to first email
        
        if debug:
            typer.echo(f"Fetched username: {username}", err=True)
            typer.echo(f"Fetched email: {email}", err=True)
        
        return username, email
        
    except (CalledProcessError, FileNotFoundError, json.JSONDecodeError) as e:
        if debug:
            typer.echo(f"Could not fetch user info automatically: {str(e)}", err=True)
        
        typer.secho("Could not automatically fetch user info. Please enter manually:", 
                   fg=typer.colors.YELLOW, err=True)
        return get_manual_credentials()


def get_gitlab_user_info(token: str, debug: bool = False) -> tuple[str, str]:
    """Fetch GitLab username and email using the API."""
    try:
        if debug:
            typer.echo("Attempting to fetch GitLab user info...", err=True)
        
        import requests
        
        headers = {'PRIVATE-TOKEN': token}
        response = requests.get('https://gitlab.com/api/v4/user', headers=headers)
        response.raise_for_status()
        
        user_data = response.json()
        username = user_data.get('username', '')
        email = user_data.get('email', '')
        
        if debug:
            typer.echo(f"Fetched username: {username}", err=True)
            typer.echo(f"Fetched email: {email}", err=True)
        
        return username, email
        
    except Exception as e:
        if debug:
            typer.echo(f"Could not fetch user info automatically: {str(e)}", err=True)
        
        typer.secho("Could not automatically fetch user info. Please enter manually:", 
                   fg=typer.colors.YELLOW, err=True)
        return get_manual_credentials()


def get_manual_credentials() -> tuple[str, str]:
    """Get username and email manually from user."""
    try:
        username = input("Username: ")
        email = input("Email: ")
        return username, email
    except KeyboardInterrupt:
        typer.echo("\nOperation cancelled", err=True)
        raise typer.Exit(0)


def get_token_from_ssm(debug: bool = False) -> str:
    """Get token from AWS SSM Parameter Store."""
    ssm_parameter = input("SSM parameter name [default: /mara/github]: ") or "/mara/github"
    
    if debug:
        typer.echo(f"Loading token from SSM: {ssm_parameter}", err=True)
    
    try:
        ssm_client = client("ssm")
        response = ssm_client.get_parameter(
            Name=ssm_parameter,
            WithDecryption=True
        )['Parameter']
        
        token = response['Value']
        
        if debug:
            typer.echo("✓ Token loaded from SSM", err=True)
        
        return token
        
    except ClientError as e:
        typer.secho(f"Error loading from SSM: {str(e)}", fg=typer.colors.RED, err=True)
        raise typer.Exit(1)


def get_token_manual() -> str:
    """Get token manually from user."""
    try:
        return input("Personal Access Token: ")
    except KeyboardInterrupt:
        typer.echo("\nOperation cancelled", err=True)
        raise typer.Exit(0)


def get_token(debug: bool = False) -> str:
    """Get Git personal access token either from SSM or manual input."""
    console.print("\n[bold cyan]How would you like to provide your token?[/bold cyan]")
    console.print("1 ❯ SSM parameter store")
    console.print("2 ❯ Paste manually")
    
    try:
        choice = input()
        choice = int(choice)
        
        if choice == 1:
            return get_token_from_ssm(debug)
        elif choice == 2:
            return get_token_manual()
        else:
            typer.secho("Invalid selection.", fg=typer.colors.YELLOW, err=True)
            raise typer.Exit(0)
            
    except ValueError:
        typer.secho("Invalid input.", fg=typer.colors.YELLOW, err=True)
        raise typer.Exit(0)
    except KeyboardInterrupt:
        typer.echo("\nOperation cancelled", err=True)
        raise typer.Exit(0)


def save_credentials(machine: str, username: str, email: str, token: str, debug: bool = False):
    """Save Git credentials to .netrc and .gitconfig files."""
    home_dir = environ['HOME']
    
    # Set fish environment variable for GH_TOKEN
    try:
        if debug:
            typer.echo("Setting GH_TOKEN in fish shell", err=True)
        run(f"set -Ux GH_TOKEN {token}", shell=True, executable="/usr/bin/fish", check=True)
    except (CalledProcessError, FileNotFoundError):
        if debug:
            typer.echo("Fish shell not available, skipping environment variable", err=True)
    
    # Write .netrc file
    if debug:
        typer.echo(f"Writing {home_dir}/.netrc", err=True)
    
    with open(f"{home_dir}/.netrc", "w") as f:
        f.write(f"machine {machine}\n")
        f.write(f"login {username}\n")
        f.write(f"password {token}\n")
    
    # Write .gitconfig file
    if debug:
        typer.echo(f"Writing {home_dir}/.gitconfig", err=True)
    
    with open(f"{home_dir}/.gitconfig", "w") as f:
        f.write("[user]\n")
        f.write(f"        name = {username}\n")
        f.write(f"        email = {email}\n")
        f.write(f"        username = {username}")


def load_credentials(debug: bool = False):
    """Main logic to load Git credentials."""
    # Get platform
    selected_platform, machine = get_platform_selection(debug)
    
    # Get token
    console.print()
    token = get_token(debug)
    
    if not token:
        typer.secho("No token provided. Exiting.", fg=typer.colors.YELLOW, err=True)
        raise typer.Exit(0)
    
    # Automatically fetch user info using the token
    console.print("\n[bold cyan]Fetching user information...[/bold cyan]")
    
    if selected_platform == "Github":
        username, email = get_github_user_info(token, debug)
    else:
        username, email = get_gitlab_user_info(token, debug)
    
    if not username or not email:
        typer.secho("Missing username or email", fg=typer.colors.YELLOW, err=True)
    
    # Save credentials
    save_credentials(machine, username, email, token, debug)
    
    # Success messages
    console.print()
    typer.secho(f"✓ {selected_platform} configured successfully!", fg=typer.colors.GREEN, bold=True)
    if username:
        typer.secho(f"  Username: {username}", fg=typer.colors.GREEN)
    if email:
        typer.secho(f"  Email: {email}", fg=typer.colors.GREEN)
    console.print("\n[bold cyan]💡 Tip:[/bold cyan] Run [bold]mara cheat-sheet -g[/bold] for useful git commands")


@app.command()
def main(
    debug: bool = typer.Option(False, "--debug", help="Show more verbose logging"),
):
    """
    Configure Git credentials using your Personal Access Token.
    
    This utility will:
    1. Ask for your Git platform (Github/Gitlab)
    2. Ask for your Personal Access Token (from SSM or manual input)
    3. Automatically fetch your username and email using the token
    4. Configure .netrc and .gitconfig files
    
    Requirements:
    - For GitHub: gh CLI installed (brew install gh)
    - For GitLab: requests library installed (pip install requests)
    """
    if debug:
        typer.echo("Debug mode enabled", err=True)
    
    try:
        load_credentials(debug)
    except NoRegionError as e:
        typer.secho(f"AWS Region Error: {str(e)}", fg=typer.colors.YELLOW, err=True)
        typer.secho("Please configure AWS region first: aws-region <region-name>", fg=typer.colors.CYAN, err=True)
        raise typer.Exit(1)


if __name__ == "__main__":
    app()