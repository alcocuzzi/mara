#!/usr/bin/env python3
"""
Mara utility to display installed tools loaded from docker build environment variables.
"""

import os
import typer
from rich.console import Console
from tabulate import tabulate

app = typer.Typer(
    help="Mara utility to display installed tools from Docker build environment variables."
)

console = Console()


def show_tools(debug: bool = False) -> None:
    """Display installed tools grouped by classification."""
    if debug:
        typer.echo("Reading tool definitions from environment variables", err=True)

    os_tools = sorted(os.getenv("OS_TOOLS", "").split())
    py_tools = sorted(os.getenv("PY_TOOLS", "").split())
    cli_tools = sorted(os.getenv("CLI_TOOLS", "").replace(",", "").split())

    if debug:
        typer.echo(f"OS_TOOLS: {len(os_tools)} entries", err=True)
        typer.echo(f"PY_TOOLS: {len(py_tools)} entries", err=True)
        typer.echo(f"CLI_TOOLS: {len(cli_tools)} entries", err=True)

    data = [
        ["OS_TOOLS", " ".join(os_tools)],
        ["PY_TOOLS", " ".join(py_tools)],
        ["CLI_TOOLS", " ".join(cli_tools)],
    ]

    console.print(
        tabulate(
            data,
            headers=["Classification", "Tool name"],
            tablefmt="rounded_grid",
        )
    )


@app.command()
def main(
    debug: bool = typer.Option(
        False,
        "--debug",
        help="Show more verbose logging",
    ),
):
    """
    Display installed tools.

    This utility reads tool definitions injected at Docker build time
    via environment variables and displays them in a readable table.
    """
    if debug:
        typer.echo("Debug mode enabled", err=True)

    show_tools(debug)


if __name__ == "__main__":
    app()
