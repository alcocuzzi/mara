#!/usr/bin/env python3
"""
Mara utility to load AWS long credentials (Access Key and Secret Access Key).
"""

import typer
import configparser
from os import environ
from subprocess import run, check_output, CalledProcessError, DEVNULL
from boto3 import client
from botocore.exceptions import ClientError, ParamValidationError
import logging

app = typer.Typer(help="Mara utility to load AWS long credentials (IAM).")

# Silence boto noise
logging.getLogger("boto3").setLevel(logging.WARNING)
logging.getLogger("botocore").setLevel(logging.WARNING)


def login(secs: int, debug: bool = False) -> None:
    home_dir = environ.get("HOME")

    if not home_dir:
        typer.secho("HOME environment variable not set", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    try:
        output = check_output(
            ["ls", "/tmp/aws"],
            stderr=DEVNULL,
            universal_newlines=True,
        )
    except CalledProcessError:
        typer.echo("No AWS profiles found. Let's create one.\n")

        try:
            aws_profile = input("AWS Profile Name: ")
            aws_access_key = input(f"AWS Access Key ID [{aws_profile}]: ")
            aws_secret_key = input(f"AWS Secret Access Key [{aws_profile}]: ")
            aws_mfa_arn = input(f"AWS MFA ARN [{aws_profile}]: ")
            aws_region = input(f"AWS Region [{aws_profile}]: ")
            aws_output = input(f"AWS Output Format [{aws_profile}]: ")
        except KeyboardInterrupt:
            raise typer.Exit(code=0)

        profile_dir = f"/tmp/aws/{aws_profile}"
        run(["mkdir", "-p", profile_dir])
        run(["touch", f"{profile_dir}/credentials"])
        run(["touch", f"{profile_dir}/config"])

        credentials_cfg = configparser.ConfigParser()
        credentials_cfg.read(f"{profile_dir}/credentials")
        credentials_cfg["default"] = {
            "aws_access_key_id": aws_access_key,
            "aws_secret_access_key": aws_secret_key,
        }

        with open(f"{profile_dir}/credentials", "w") as f:
            credentials_cfg.write(f)

        config_cfg = configparser.ConfigParser()
        config_cfg.read(f"{profile_dir}/config")
        config_cfg["default"] = {
            "region": aws_region,
            "output": aws_output,
            "mfa_serial": aws_mfa_arn,
        }

        with open(f"{profile_dir}/config", "w") as f:
            config_cfg.write(f)

        if debug:
            typer.echo(f"Created profile {aws_profile}", err=True)

        output = check_output(
            ["ls", "/tmp/aws"],
            stderr=DEVNULL,
            universal_newlines=True,
        )

    folders = sorted(output.split())

    typer.echo("\n╭─────────────────────────────────────────────────╮")
    typer.echo("│     ↓ ↓     Available AWS Profiles     ↓ ↓      │")
    typer.echo("╰─────────────────────────────────────────────────╯\n")

    for i, folder in enumerate(folders, 1):
        typer.echo(f"{i} ➦ {folder}")

    try:
        selected = int(input("\nSelect profile number: "))
        if not 1 <= selected <= len(folders):
            raise ValueError
    except (ValueError, KeyboardInterrupt):
        typer.secho("Invalid selection", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=0)

    selected_profile = folders[selected - 1]
    profile_path = f"/tmp/aws/{selected_profile}"

    if debug:
        typer.echo(f"Using profile {selected_profile}", err=True)

    # Copy base credentials + config
    creds = configparser.ConfigParser()
    creds.read(f"{profile_path}/credentials")
    with open(f"{home_dir}/.aws/credentials", "w") as f:
        creds.write(f)

    cfg = configparser.ConfigParser()
    cfg.read(f"{profile_path}/config")
    with open(f"{home_dir}/.aws/config", "w") as f:
        cfg.write(f)

    mfa_serial = cfg.get("default", "mfa_serial", fallback=None)
    aws_region = cfg.get("default", "region", fallback=None)

    sts = client("sts")

    try:
        if mfa_serial:
            token = input("Enter MFA code: ")
            response = sts.get_session_token(
                DurationSeconds=secs,
                SerialNumber=mfa_serial,
                TokenCode=token,
            )
        else:
            response = sts.get_session_token(DurationSeconds=secs)
    except (ClientError, ParamValidationError) as e:
        typer.secho(str(e), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    temp_creds = configparser.ConfigParser()
    temp_creds.read(f"{home_dir}/.aws/credentials")
    temp_creds["default"].update(
        {
            "aws_access_key_id": response["Credentials"]["AccessKeyId"],
            "aws_secret_access_key": response["Credentials"]["SecretAccessKey"],
            "aws_session_token": response["Credentials"]["SessionToken"],
        }
    )

    with open(f"{home_dir}/.aws/credentials", "w") as f:
        temp_creds.write(f)

    # Account info
    identity_info = sts.get_caller_identity()
    identity = identity_info["Arn"].split("/")[-1]
    acc_number = identity_info["Account"]

    try:
        acc_alias = client("iam").list_account_aliases()["AccountAliases"][0]
    except IndexError:
        acc_alias = ""

    # Clean old Fish vars
    for var in ("mara_acc_number", "mara_acc_alias"):
        try:
            run(f"set -e {var}", shell=True, executable="/usr/bin/fish", check=True)
        except CalledProcessError:
            pass

    if not aws_region:
        aws_region = run(
            f"grep region {home_dir}/.aws/config | awk '{{print $3}}'",
            shell=True,
            executable="/usr/bin/fish",
            capture_output=True,
            text=True,
        ).stdout.strip()

    run(f"set -Ux mara_region {aws_region}", shell=True, executable="/usr/bin/fish", check=True)
    run(f"set -Ux mara_identity {identity}", shell=True, executable="/usr/bin/fish", check=True)

    if acc_alias:
        run(f"set -Ux mara_acc_alias {acc_alias}", shell=True, executable="/usr/bin/fish", check=True)
    else:
        run(f"set -Ux mara_acc_number {acc_number}", shell=True, executable="/usr/bin/fish", check=True)

    typer.secho("AWS IAM credentials successfully loaded", fg=typer.colors.GREEN)


@app.command()
def main(
    secs: int = typer.Option(
        10800,
        "--secs",
        "-s",
        help="Duration in seconds the credentials should remain valid",
    ),
    debug: bool = typer.Option(
        False,
        "--debug",
        help="Show more verbose logging",
    ),
):
    """
    Load AWS long-term IAM credentials and generate a temporary session.

    Supports MFA-enabled profiles and updates the shell environment
    with the active account context.
    """
    if debug:
        typer.echo("Debug mode enabled", err=True)

    login(secs, debug)


if __name__ == "__main__":
    app()
