#!/usr/bin/env python3
"""
Mara utility to load short-term AWS SSO credentials.
"""

import typer
import configparser
from os import environ, path
from subprocess import run, CalledProcessError
from boto3 import client
from botocore.exceptions import ClientError
import logging

app = typer.Typer(help="Mara utility to load short-term AWS SSO credentials.")

# Silence boto noise
logging.getLogger("boto3").setLevel(logging.WARNING)
logging.getLogger("botocore").setLevel(logging.WARNING)


def load_credentials(region: str, debug: bool = False) -> None:
    """Prompt user to paste AWS SSO credentials and store them locally."""
    typer.echo(
        "╭─────────────────────────────────────────────────────────────────────────────────────────────────────╮"
    )
    typer.echo(
        "│                   ↓ ↓     Paste your AWS SSO credentials below     ↓ ↓                              │"
    )
    typer.echo(
        "│                 When you're done, press Enter twice to save and continue.                           │"
    )
    typer.echo(
        "╰─────────────────────────────────────────────────────────────────────────────────────────────────────╯\n"
    )

    credentials: dict[str, str] = {}

    while True:
        try:
            line = input()
        except KeyboardInterrupt:
            raise typer.Exit(code=0)

        if not line:
            break

        line = line.strip()

        try:
            if line.startswith("export"):
                line = line.replace("export", "").replace('"', "")
            elif line.startswith("SET"):
                line = line.replace("SET", "").replace('"', "")
            elif line.startswith("$Env:"):
                line = line.replace("$Env:", "").replace('"', "")
            elif line.startswith("AWS"):
                pass
            else:
                raise ValueError

            key, value = line.split("=", 1)
            credentials[key.strip()] = value.strip()

        except ValueError:
            typer.secho(
                "Whoops! Looks like the AWS SSO credentials were pasted in the wrong format.\n"
                "Please copy and paste them exactly as shown in the SSO console snippet.",
                fg=typer.colors.RED,
                err=True,
            )
            raise typer.Exit(code=1)

    if not credentials:
        typer.secho("No credentials provided", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    access_key = credentials.get("AWS_ACCESS_KEY_ID")
    secret_key = credentials.get("AWS_SECRET_ACCESS_KEY")
    session_token = credentials.get("AWS_SESSION_TOKEN")

    if debug:
        typer.echo(f"AWS_ACCESS_KEY_ID: {access_key[:20]}", err=True)
        typer.echo(f"AWS_SECRET_ACCESS_KEY: {secret_key[:20]}", err=True)
        typer.echo(f"AWS_SESSION_TOKEN: {session_token[:20]}", err=True)

    store_credentials(access_key, secret_key, session_token, region, debug)


def store_credentials(
    access_key: str,
    secret_key: str,
    session_token: str,
    region: str,
    debug: bool = False,
) -> None:
    """Store AWS credentials, configure region, and update Fish env vars."""
    home_dir = environ.get("HOME")

    if not home_dir:
        typer.secho("HOME environment variable not set", fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    credentials_path = path.join(home_dir, ".aws", "credentials")
    config_path = path.join(home_dir, ".aws", "config")

    # Write credentials
    config = configparser.ConfigParser()
    config.read(credentials_path)

    if not config.has_section("default"):
        config.add_section("default")

    config.set("default", "aws_access_key_id", access_key)
    config.set("default", "aws_secret_access_key", secret_key)
    config.set("default", "aws_session_token", session_token)

    with open(credentials_path, "w") as f:
        config.write(f)

    # Write region config
    region_config = configparser.ConfigParser()
    region_config.read(config_path)

    if not region_config.has_section("default"):
        region_config.add_section("default")

    region_config.set("default", "region", region)
    region_config.set("default", "output", "json")

    with open(config_path, "w") as f:
        region_config.write(f)

    if debug:
        typer.echo(f"AWS region set to {region}", err=True)

    # Fetch account info
    try:
        sts = client("sts")
        identity_info = sts.get_caller_identity()
        identity = identity_info["Arn"].split("/")[-1]
        acc_number = identity_info["Account"]

        try:
            acc_alias = client("iam").list_account_aliases()["AccountAliases"][0]
        except IndexError:
            acc_alias = ""
            if debug:
                typer.echo("Account has no alias, using account number", err=True)

    except ClientError as e:
        typer.secho(str(e), fg=typer.colors.RED, err=True)
        raise typer.Exit(code=1)

    # Clean existing Fish vars
    for var in ("mara_acc_number", "mara_acc_alias"):
        try:
            run(
                f"set -e {var}",
                shell=True,
                executable="/usr/bin/fish",
                check=True,
            )
        except CalledProcessError:
            pass

    # Set Fish vars
    run(f"set -Ux mara_region {region}", shell=True, executable="/usr/bin/fish", check=True)
    run(f"set -Ux mara_identity {identity}", shell=True, executable="/usr/bin/fish", check=True)

    if acc_alias:
        run(
            f"set -Ux mara_acc_alias {acc_alias}",
            shell=True,
            executable="/usr/bin/fish",
            check=True,
        )
    else:
        run(
            f"set -Ux mara_acc_number {acc_number}",
            shell=True,
            executable="/usr/bin/fish",
            check=True,
        )

    typer.secho("AWS SSO credentials successfully loaded", fg=typer.colors.GREEN)


@app.command()
def main(
    region: str = typer.Option(
        "eu-west-1",
        "--region",
        "-r",
        help="Default AWS region for the credentials profile",
    ),
    debug: bool = typer.Option(
        False,
        "--debug",
        help="Show more verbose logging",
    ),
):
    """
    Load short-term AWS SSO credentials.

    Paste credentials copied from the AWS SSO console and this utility
    will configure your local AWS CLI and shell environment.
    """
    if debug:
        typer.echo("Debug mode enabled", err=True)

    load_credentials(region, debug)


if __name__ == "__main__":
    app()
